{
  "name": "coriolis-wx",
  "version": "0.3.0",
  "description": "Weather events, drawn as dots: cyclones, rolling clouds and thunderstorms, fork and ball lightning, on one canvas. No dependencies.",
  "main": "src/coriolis.js",
  "files": ["dist", "src", "README.md", "LICENSE"],
  "scripts": {
    "check": "node -e \"require('./src/coriolis.js'); console.log('ok')\"",
    "serve": "python -m http.server 8080",
    "build": "node tools/build.js"
  },
  "keywords": ["canvas", "animation", "weather", "cyclone", "hurricane", "typhoon", "stipple", "dots"],
  "author": "TonkaTuff",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/TonkaTuff/coriolis.git" },
  "devDependencies": { "terser": "^5.36.0" },
  "unpkg": "dist/coriolis.min.js",
  "jsdelivr": "dist/coriolis.min.js"
}
